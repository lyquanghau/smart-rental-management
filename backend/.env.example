NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/smart_rental_dev
JWT_SECRET=replace_with_a_strong_secret_at_least_32_characters
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173
# Dung CLIENT_URLS khi can cho phep nhieu frontend origin, cach nhau bang dau phay.
# Vi du: CLIENT_URLS=http://localhost:5173,https://smart-rental.vercel.app
ALLOW_PUBLIC_REGISTRATION=false
# Production nen de false neu chua co xac minh email/duyet chu tro. Dev co the bat true de test POST /auth/register.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
