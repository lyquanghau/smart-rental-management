NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/smart_rental_dev
JWT_SECRET=replace_with_a_strong_secret_at_least_32_characters
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173
# Dung CLIENT_URLS khi can cho phep nhieu frontend origin, cach nhau bang dau phay.
# Vi du: CLIENT_URLS=http://localhost:5173,https://smart-rental.vercel.app
ALLOW_PUBLIC_REGISTRATION=false
# Production nen de false neu chua co xac minh email/duyet chu tro. Dev co the bat true de test POST /auth/register.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
DISCORD_WEBHOOK_URL=
# Tuy chon: Discord Incoming Webhook URL de bao chu tro khi SePay xac nhan thanh toan thanh cong.

# SMTP email gui thong tin tai khoan khach thue.
# Co the dung Gmail App Password, Mailtrap, Brevo, Zoho hoac SMTP server khac.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Smart Rental <no-reply@smartrental.local>"

# MoMo payment gateway.
# Dev mac dinh co the dung mock mode de demo webhook tu dong khi chua co tai khoan MoMo merchant.
MOMO_MOCK_MODE=true
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost:5173/tenant-portal
MOMO_IPN_URL=http://localhost:5000/api/webhooks/momo

# SePay bank webhook / VietQR automation.
# Huong nhanh: my.sepay.vn -> Webhooks -> Add webhook -> Money in -> HMAC-SHA256.
# Webhook URL local/dev public: https://<domain-or-ngrok>/api/webhooks/sepay
# Copy Secret Key vao SEPAY_WEBHOOK_SECRET ngay luc tao, vi SePay chi hien day du mot lan.
SEPAY_MOCK_MODE=true
SEPAY_AUTH_MODE=hmac
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
